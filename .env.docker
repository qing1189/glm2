# ============================================
# GLM-2API Docker 环境变量配置
# 复制此文件或直接修改后使用
# ============================================

# Z.ai JWT Token（多个用英文逗号分隔）
GLM_TOKENS=your_jwt_token_here

# Z.ai 账号密码（格式: email:password，多个用英文逗号分隔）
# 与 GLM_TOKENS 二选一即可
GLM_ACCOUNTS=your_email:your_password

# API 服务端口
PORT=3003

# API 访问密钥（留空则不验证）
API_KEY=

# 代理设置（可选，留空则直连）
HTTPS_PROXY=
HTTP_PROXY=

# 管理面板密码（默认 admin123，强烈建议修改）
ADMIN_PASSWORD=admin123

# 调试模式（设为 1 开启 SSE 调试日志）
DEBUG_SSE=0

# ============================================
# 以下为 Docker 内部使用，一般无需修改
# ============================================
# CHROME_PATH=/usr/bin/google-chrome-stable
# USER_DATA_DIR=/app/edge-profile
# GLM_SERVER_MODE=1
