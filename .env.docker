# ============================================
# GLM-2API Docker 环境变量配置
# ============================================

# API 服务端口
PORT=3003

# API 访问密钥（留空则不验证）
API_KEY=

# 代理设置（可选，留空则直连）
HTTPS_PROXY=
HTTP_PROXY=

# 管理面板密码（默认 admin123，强烈建议修改）
ADMIN_PASSWORD=admin123

# 调试模式（设为 1 开启 SSE 调试日志）
DEBUG_SSE=0

# ============================================
# Z.ai 账号/Token 请通过管理面板添加：
# http://localhost:3003/admin
# 管理面板支持热加载，无需重启容器
# ============================================
