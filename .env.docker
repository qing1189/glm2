# ============================================
# GLM-2API Docker 环境变量配置
# ============================================

# API 服务端口
PORT=3003

# 管理面板密码（默认 admin123，强烈建议修改）
ADMIN_PASSWORD=admin123

# 代理设置（可选，留空则直连）
HTTPS_PROXY=
HTTP_PROXY=

# 调试模式（设为 1 开启 SSE 调试日志）
DEBUG_SSE=0

# ============================================
# Z.ai Token/账号、API Key 等均通过管理面板配置：
# http://localhost:3003/admin
# 数据自动持久化，重启不丢失
# ============================================
